{
  // Directory for Wannier90 files
  "src": "source",
  // Output directory for TB2J files
  "out": "output",
  // Magnetic element for exchange calculation
  "mag": "Cr",
  // Ligand element for exchange calculation
  "lig": "Cl",
  // Mixing degrees d/p Wannier function
  "thetas": [-10, 0, 10],
  "efermi": 0.0,
  "kmesh": [5, 5, 5],
  "smearing": 0.02,
  // Wannier90 file prefixes for hopping matrix extraction
  "prefixes": ["wannier90.1", "wannier90.2"],
  // up, down, average
  "weight": "up",
  // Maximum hopping distance (Å)
  "bond": 3.0,
  "elements": ["Cr"],
  "rcut": 30.0,
  "nz": 100,
  // Output atom pair distance (Å), null for all
  "distance": null,
  // Tolerance for selecting atom pairs by distance (Å)
  "tolerance": 0.005
}
