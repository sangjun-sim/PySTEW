! Fixed MP-derived geometry; AFM-II and U are calculation choices.
&CONTROL
  calculation = 'bands',
  prefix = 'nio',
  pseudo_dir = '../scf/pseudo',
  outdir = './tmp',
/
&SYSTEM
  ibrav = 0,
  nat = 4,
  ntyp = 3,
  ecutwfc = 110.0,
  ecutrho = 440.0,
  nbnd = 40,
  nspin = 2,
  starting_magnetization(1) = 0.1,
  starting_magnetization(2) = -0.1,
  starting_magnetization(3) = 0.0,
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.005,
  nosym = .true.,
  noinv = .true.,
/
&ELECTRONS
  conv_thr = 1.0d-10,
  startingpot = 'file',
  diago_full_acc = .true.,
  diago_thr_init = 1.0d-10,
/

ATOMIC_SPECIES
Ni1 58.6934 Ni_std.upf
Ni2 58.6934 Ni_std.upf
O   15.9994 O_std.upf

CELL_PARAMETERS angstrom
2.119568000 2.119568000 4.239136000
4.239136000 2.119568000 2.119568000
2.119568000 4.239136000 2.119568000

ATOMIC_POSITIONS crystal
Ni1 0.000000000 0.000000000 0.000000000
Ni2 0.500000000 0.500000000 0.500000000
O 0.250000000 0.250000000 0.250000000
O 0.750000000 0.750000000 0.750000000

! SeeK-path hR1 for the AFM cell, in this cell's reciprocal coordinates.
! GAMMA-T-H_2 | H_0-L-GAMMA-S_0 | S_2-F-GAMMA; 0 skips a path break.
K_POINTS crystal_b
10
0.000000000 0.000000000  0.000000000 40 ! GAMMA
0.500000000 0.500000000  0.500000000 40 ! T
0.500000000 0.812500000  0.187500000  0 ! H_2
0.187500000 0.500000000 -0.187500000 40 ! H_0
0.000000000 0.500000000  0.000000000 40 ! L
0.000000000 0.000000000  0.000000000 40 ! GAMMA
0.000000000 0.343750000 -0.343750000  0 ! S_0
0.343750000 0.656250000  0.000000000 40 ! S_2
0.500000000 0.500000000  0.000000000 40 ! F
0.000000000 0.000000000  0.000000000  1 ! GAMMA

HUBBARD (ortho-atomic)
U Ni1-3d 6.2
U Ni2-3d 6.2
